# Server-only secrets: use supabase secrets set --env-file supabase/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase Edge runtime.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Generate a random 32+ character secret locally. No VITE_ prefix.
RATE_LIMIT_SECRET=
